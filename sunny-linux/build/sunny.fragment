# sunny.fragment — config ที่ต้องมีเพื่อบูต Ubuntu (ไม่ใช่ Android)
# ใช้กับ: 02-kernel.sh (merge เข้า defconfig ของ kernel CAF)

# --- CPU topology: type เป็น int (bitmask) ไม่ใช่ string; 0 = auto ตาม help ---
CONFIG_NR_CPUS=8
CONFIG_LITTLE_CPU_MASK=0
CONFIG_BIG_CPU_MASK=0
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_SCHED_MC=y
# tree นี้ cmpxchg.h เรียก ARM64_LSE_ATOMIC_INSN แบบไม่มี fallback
# และ lse.h นิยาม macro ก็ต่อเมื่อ ARM64_LSE_ATOMICS=y (AS_LSE มาจาก as-instr ใน Makefile)
CONFIG_ARM64_LSE_ATOMICS=y

# --- core ที่ Android defconfig ปิด/ไม่ตั้ง ---
CONFIG_WERROR=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_CMDLINE_EXTEND=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y

# --- systemd ต้องใช้ ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
CONFIG_FANOTIFY=y
CONFIG_AUTOFS4_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SHMEM=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_UNIX98_PTYS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# --- UFS (rootfs อยู่บน userdata) ---
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SCSI_UFS_DWC=y

# --- USB gadget: RNDIS → usb0 (ssh ผ่าน USB) + ACM → ttyGS0 (console สำรอง) ---
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_F_ACM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_RNDIS_HOST=y

# --- จอ (ถ้า DTS ยังไม่มี panel driver จะได้ fb0 เปล่า ๆ) ---
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_MSM=y

# --- network ---
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y

# --- ไม่ต้องใช้กับ server ---
# CONFIG_TECHPACK_AUDIO=y
# CONFIG_TECHPACK_CAMERA=y

# --- Xiaomi device flag: ซอร์สของ tree นี้ guard ฟิลด์จำนวนมากด้วยตัวนี้ ---
# (power_supply.arrayval, qpnp_qg.profile_judge_done, cam_sensor_board_info.camera_id ...)
# ถ้าไม่เปิด = คอมไพล์ไม่ผ่าน
CONFIG_XIMI_MOJITO=y

# --- กล้อง: ไม่ใช้บน server + techpack กล้องอ้าง is_libcam (นิยามใน init/userland_worker.c
#     ซึ่งไม่ถูกคอมไพล์ใน config นี้) → ปิดทั้งก้อน ---
# CONFIG_SPECTRA_CAMERA is not set
